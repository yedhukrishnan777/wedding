# Copy this file to ".env" and fill it in (or set these in your hosting dashboard).
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=any-long-random-text
# Where the database and uploaded photos live. On hosting, point this at a persistent disk.
# DATA_DIR=/var/data
# Optional: your public address, used for WhatsApp previews (can also be set in the admin panel).
# BASE_URL=https://www.yourdomain.com
# PORT=3000
